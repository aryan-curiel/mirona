{
  "$description": "Mirona design tokens v0.1. Light theme at the top level; colorDark holds the dark theme (CSS: [data-theme=\"dark\"]). Same values as tokens.css.",
  "color": {
    "accent": {
      "base": "#0E7466",
      "strong": "#0B5C51",
      "tint": "#E3F1EE",
      "avatar": "#D5EBE6"
    },
    "text": {
      "ink": "#1C1C1A",
      "ink2": "#2C2C29",
      "ink3": "#3A3A36",
      "muted": "#5E5E58",
      "disabled": "#77776F"
    },
    "line": {
      "base": "#E2E2DC",
      "soft": "#EDEDE8",
      "control": "#D9D9D2"
    },
    "neutral": {
      "tint": "#EDEDE8",
      "text": "#55554F"
    },
    "decision": {
      "text": "#2F3C99",
      "tint": "#E8EAFA",
      "avatar": "#E1E4F8"
    },
    "question": {
      "text": "#7A4800",
      "tint": "#FBF0DC",
      "avatar": "#F8E7C7"
    },
    "review": {
      "edge": "#B7791F",
      "tint": "#FFF4D6",
      "text": "#7A4800"
    },
    "sensitive": {
      "text": "#9B2C22",
      "tint": "#FBE9E7"
    },
    "record": {
      "base": "#C2362B",
      "text": "#8E2219",
      "tint": "rgba(253,236,232,0.7)"
    },
    "backdrop": {
      "base": "#ECEFEE",
      "glows": [
        {
          "color": "rgba(14,116,102,0.24)",
          "size": "900px 640px",
          "at": "8% 0%",
          "fade": "62%"
        },
        {
          "color": "rgba(63,79,184,0.18)",
          "size": "820px 620px",
          "at": "96% 12%",
          "fade": "60%"
        },
        {
          "color": "rgba(214,150,80,0.20)",
          "size": "1000px 720px",
          "at": "55% 105%",
          "fade": "62%"
        }
      ]
    }
  },
  "glass": {
    "panel": {
      "background": "rgba(255,255,255,0.45)",
      "backdropFilter": "blur(28px) saturate(170%)",
      "edge": "rgba(255,255,255,0.75)"
    },
    "card": {
      "background": "rgba(255,255,255,0.55)",
      "backdropFilter": "blur(22px) saturate(160%)",
      "edge": "rgba(255,255,255,0.8)",
      "shadow": "0 10px 30px rgba(20,40,36,0.07), inset 0 1px 0 rgba(255,255,255,0.9)",
      "radius": 16
    },
    "row": {
      "background": "rgba(255,255,255,0.52)",
      "backdropFilter": "blur(16px)",
      "shadow": "0 4px 18px rgba(20,40,36,0.05), inset 0 1px 0 rgba(255,255,255,0.9)",
      "radius": 12
    },
    "rowSelected": {
      "background": "rgba(240,248,246,0.82)",
      "border": "#0E7466",
      "shadow": "inset 3px 0 0 #0E7466, 0 10px 28px rgba(14,116,102,0.12)"
    },
    "control": {
      "background": "rgba(255,255,255,0.6)",
      "hover": "rgba(255,255,255,0.88)",
      "backdropFilter": "blur(12px)",
      "edge": "rgba(255,255,255,0.9)",
      "shadow": "0 1px 3px rgba(20,40,36,0.08)"
    },
    "navActive": {
      "background": "rgba(255,255,255,0.72)",
      "shadow": "0 0 0 1px rgba(255,255,255,0.9), 0 4px 14px rgba(20,40,36,0.08)"
    }
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "display": {
      "size": 32,
      "weight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "size": 26,
      "weight": 700,
      "lineHeight": 1.25,
      "letterSpacing": "-0.015em"
    },
    "title": {
      "size": 18,
      "weight": 700,
      "lineHeight": 1.3
    },
    "bodyStrong": {
      "size": 14,
      "weight": 600,
      "lineHeight": 1.45
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.45
    },
    "small": {
      "size": 13,
      "weight": 400,
      "lineHeight": 1.45
    },
    "caption": {
      "size": 12,
      "weight": 500,
      "lineHeight": 1.5
    },
    "label": {
      "size": 12,
      "weight": 600,
      "lineHeight": 1.5,
      "textTransform": "uppercase",
      "letterSpacing": "0.04em"
    },
    "mono": {
      "family": "mono",
      "size": 12,
      "weight": 500,
      "lineHeight": 1.5
    }
  },
  "radius": {
    "xs": 3,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "pill": 999,
    "iconTile": "24%"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32
  },
  "size": {
    "control": 36,
    "controlLarge": 44,
    "avatar": 36,
    "sidebar": 248,
    "inspector": 340
  },
  "classification": {
    "defaultThreshold": 0.6,
    "unsureBand": [
      0.4,
      0.6
    ]
  },
  "colorDark": {
    "accent": {
      "base": "#3FB8A5",
      "strong": "#6FD3C2",
      "tint": "#173A35",
      "avatar": "#1E4741"
    },
    "text": {
      "ink": "#F2F2EE",
      "ink2": "#E2E2DC",
      "ink3": "#CFCFC8",
      "muted": "#A3A39B",
      "disabled": "#7E7E77"
    },
    "line": {
      "base": "#3A3A36",
      "soft": "#2F2F2C",
      "control": "#45453F"
    },
    "neutral": {
      "tint": "#2F2F2C",
      "text": "#BDBDB5"
    },
    "decision": {
      "text": "#A9B3F5",
      "tint": "#252A4D",
      "avatar": "#2A2F55"
    },
    "question": {
      "text": "#F2C27A",
      "tint": "#3D2E14",
      "avatar": "#45351A"
    },
    "review": {
      "edge": "#D69E3A",
      "tint": "#3A2F17",
      "text": "#F2C27A"
    },
    "sensitive": {
      "text": "#F4A49A",
      "tint": "#43201C"
    },
    "record": {
      "base": "#E5584B",
      "text": "#F4A49A",
      "tint": "rgba(120,30,24,0.45)"
    },
    "backdrop": {
      "base": "#121514"
    },
    "glass": {
      "panel": "rgba(28,32,31,0.55)",
      "card": "rgba(34,38,37,0.62)",
      "row": "rgba(34,38,37,0.58)",
      "rowSelected": "rgba(20,60,54,0.72)",
      "control": "rgba(255,255,255,0.06)"
    }
  }
}
